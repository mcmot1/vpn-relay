[Unit]
Description=AmneziaWG WebSocket relay
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
LoadCredential=config.yaml:/etc/vpn-relay/config.yaml
ExecStartPre=/usr/bin/awk '/REPLACE_WITH_SHARED_SECRET|vpn-egress[.]example[.]com/ { invalid=1 } END { exit invalid }' %d/config.yaml
ExecStart=/usr/local/bin/gost -C %d/config.yaml
Restart=on-failure
RestartSec=3s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
